# Local-only TLS harness for A4. Production continues to use deploy/Caddyfile.
(api_upstream) {
	header_up -X-Forwarded-Proto
	header_up X-Forwarded-Proto {http.request.scheme}
	header_up -X-Noosphere-Forwarded-Proto
	header_up X-Noosphere-Forwarded-Proto {http.request.scheme}
	header_up -X-Noosphere-Client-IP
	header_up X-Noosphere-Client-IP {http.request.remote.host}
}

{$PUBLIC_HOST} {
	tls internal
	encode gzip
	request_body {
		max_size 53MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
	}

	@allowed_host host {$PUBLIC_HOST}
	handle @allowed_host {
		@health path /health/*
		reverse_proxy @health api:3001 {
			import api_upstream
		}

		@oauth_metadata path /.well-known/oauth-*
		reverse_proxy @oauth_metadata api:3001 {
			import api_upstream
		}

		@oauth path /oauth/*
		reverse_proxy @oauth api:3001 {
			import api_upstream
		}

		@mcp path /mcp
		reverse_proxy @mcp api:3001 {
			import api_upstream
		}

		reverse_proxy web:3000
	}

	# The TLS site can be selected by a valid SNI while the HTTP Host is
	# different. Never let that request fall through to the web application.
	handle {
		header Content-Type application/json
		respond `{"error":{"code":"MCP_HOST_NOT_ALLOWED"}}` 403
	}
}

# A bare HTTPS site address is selected for SNI/Host values which do not
# select the configured public site. It is deliberately terminal: foreign
# requests must never reach either application upstream.
:443 {
	tls internal
	header {
		-Server
		Content-Type application/json
	}
	respond `{"error":{"code":"MCP_HOST_NOT_ALLOWED"}}` 403
}
