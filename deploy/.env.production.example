# Copy to .env on the VPS and replace every placeholder. Never commit the real file.
APP_VERSION=v0.1.0
PUBLIC_HOST=noosphere.ignitionai.fr
BETTER_AUTH_URL=https://noosphere.ignitionai.fr
BETTER_AUTH_TRUSTED_ORIGINS=https://noosphere.ignitionai.fr
PUBLIC_WEBHOOK_BASE_URL=https://noosphere.ignitionai.fr

POSTGRES_DB=ignition_outbound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

S3_BUCKET=ignition-outbound
S3_ACCESS_KEY_ID=replace-with-a-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-random-secret
SEARXNG_SECRET=replace-with-a-random-secret
CRAWLER_API_KEY=replace-with-a-random-secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_ALLOW_SIGN_UP=false
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-bootstrap-password
BOOTSTRAP_WORKSPACE_SLUG=ignition-ai
BOOTSTRAP_WORKSPACE_NAME=IgnitionAI

AI_PROVIDER=codex-cli
CODEX_DEFAULT_MODEL=gpt-5.6-luna
CODEX_DEFAULT_REASONING_EFFORT=xhigh
CODEX_FALLBACK_MODELS=gpt-5.4-mini
CODEX_BINARY_PATH=codex
# Optional Kimi routes/fallbacks:
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_RESEARCH_MODELS=k3,k3-256k
PROSPECT_DECISION_MODEL=k3
KIMI_SYNTHESIS_MODELS=k3-256k,k3
KIMI_FALLBACK_MODELS=kimi-for-coding-highspeed
# Required only when an AI route explicitly uses the OpenAI provider.
OPENAI_API_KEY=
TEI_EMBEDDING_RUNTIME_MODEL_ID=janni-t/qwen3-embedding-0.6b-int8-tei-onnx
TEI_EMBEDDING_RUNTIME_MODEL_SHA=8fe0c238c7c48016d28e750413ca492024be3ddf
TEI_EMBEDDING_DIMENSION=1024
TEI_RERANKER_RUNTIME_MODEL_ID=csylabs/bge-reranker-v2-m3-int8-onnx
TEI_RERANKER_RUNTIME_MODEL_SHA=eaf5072d7b1a3f1fa584cc7482c7efb8f784dca0

UNIPILE_ENABLED=true
UNIPILE_DSN=https://api37.unipile.com:16796
UNIPILE_API_KEY=replace-with-unipile-key
UNIPILE_LINKEDIN_ACCOUNT_ID=
UNIPILE_WHATSAPP_ACCOUNT_ID=
UNIPILE_WEBHOOK_SECRET=replace-with-webhook-signing-secret
UNIPILE_INBOX_SYNC_ENABLED=true
UNIPILE_SOCIAL_CONTENT_SYNC_ENABLED=true
UNIPILE_SOCIAL_ENGAGEMENT_SYNC_ENABLED=true
CALENDAR_ENABLED=false
CALENDAR_WEBHOOK_SIGNING_KEY=

OUTBOUND_LINKEDIN_DAILY_LIMIT=20
OUTBOUND_EMAIL_DAILY_LIMIT=50
OUTBOUND_WHATSAPP_DAILY_LIMIT=30
BOOKING_URL=
BACKUP_DIR=/srv/noosphere/backups
RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/noosphere-backups
RESTIC_PASSWORD_FILE=/root/.config/noosphere/restic-password
# Required by Restic when RESTIC_REPOSITORY uses S3-compatible storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALERT_WEBHOOK_URL=
