{
  "openapi": "3.1.0",
  "info": {
    "title": "Ignition Outbound Product Research API",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/workspace-ai-settings": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "get": {
        "operationId": "getWorkspaceAiSettings",
        "summary": "Read the effective workspace AI model policy",
        "responses": {
          "200": {
            "description": "Effective model policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAiSettings"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          }
        }
      },
      "put": {
        "operationId": "updateWorkspaceAiSettings",
        "summary": "Update the ordered workspace AI model policy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceAiSettingsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved model policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAiSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          }
        }
      }
    },
    "/api/v1/product-research-runs": {
      "post": {
        "operationId": "createProductResearchRun",
        "summary": "Create a product research draft",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceSlug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductResearchBrief"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "get": {
        "operationId": "getProductResearchRun",
        "summary": "Read run state and progress",
        "responses": {
          "200": {
            "description": "Current run state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResearchRun"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/evidence": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "get": {
        "operationId": "listProductResearchEvidence",
        "summary": "List sourced evidence",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor page of evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/start": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "startProductResearchRun",
        "summary": "Queue the first research stage",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/pause": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "pauseProductResearchRun",
        "summary": "Pause future stage execution",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/resume": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "resumeProductResearchRun",
        "summary": "Resume the next incomplete stage",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/research-more": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "requestMoreProductResearch",
        "summary": "Invalidate machine checkpoints and restart from a stage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchMoreRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/report": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "get": {
        "operationId": "getProductResearchReport",
        "summary": "Read the evidence-backed ICP report",
        "responses": {
          "200": {
            "description": "Product, competitors, segments, ICP proposals and evidence audit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResearchReport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/approve-icp": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "approveIcpProposal",
        "summary": "Explicitly approve one ICP proposal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IcpReviewRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ICP proposal approved"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/reject-icp": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "rejectIcpProposal",
        "summary": "Explicitly reject one ICP proposal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IcpReviewRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ICP proposal rejected"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/research-documents": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "get": {
        "operationId": "listResearchDocuments",
        "summary": "List workspace-scoped research documents",
        "responses": {
          "200": {
            "description": "Research documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ResearchDocument"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research-documents/upload-intents": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "createResearchDocumentUploadIntent",
        "summary": "Create a direct object-storage upload intent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchDocumentUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload intent created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "document",
                    "uploadUrl",
                    "expiresInSeconds"
                  ],
                  "properties": {
                    "document": {
                      "$ref": "#/components/schemas/ResearchDocument"
                    },
                    "uploadUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expiresInSeconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/api/v1/research-documents/{documentId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "delete": {
        "operationId": "deleteResearchDocument",
        "summary": "Soft-delete a workspace research document",
        "responses": {
          "204": {
            "description": "Document deleted"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/research-documents/{documentId}/complete": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentId"
        },
        {
          "$ref": "#/components/parameters/WorkspaceSlug"
        }
      ],
      "post": {
        "operationId": "completeResearchDocumentUpload",
        "summary": "Verify an upload and queue Docling extraction",
        "responses": {
          "202": {
            "description": "Document processing queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchDocument"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "parameters": {
      "WorkspaceSlug": {
        "name": "x-workspace-slug",
        "in": "header",
        "required": true,
        "description": "Workspace selected by the route. Membership is validated server-side.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        }
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DocumentId": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "ActionAccepted": {
        "description": "Action accepted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResearchActionResponse"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "Invalid request",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "WorkspaceForbidden": {
        "description": "Workspace role is insufficient",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "RunNotFound": {
        "description": "Run absent from the current workspace",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidState": {
        "description": "The requested transition is invalid",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "WorkspaceAiModelList": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      },
      "WorkspaceAiSettingsInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "researchModels",
          "synthesisModels"
        ],
        "properties": {
          "researchModels": {
            "$ref": "#/components/schemas/WorkspaceAiModelList"
          },
          "synthesisModels": {
            "$ref": "#/components/schemas/WorkspaceAiModelList"
          }
        }
      },
      "WorkspaceAiSettings": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WorkspaceAiSettingsInput"
          },
          {
            "type": "object",
            "required": [
              "source",
              "updatedAt"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "workspace",
                  "environment"
                ]
              },
              "updatedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        ]
      },
      "ResearchStage": {
        "type": "string",
        "enum": [
          "product_analysis",
          "competitor_discovery",
          "competitor_analysis",
          "segment_synthesis",
          "icp_synthesis",
          "evidence_review"
        ]
      },
      "ProductResearchBrief": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productUrl",
          "productName",
          "description",
          "geography",
          "languages",
          "salesMotion",
          "knownCompetitors",
          "internalDocumentIds",
          "depth"
        ],
        "properties": {
          "productUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "const": ""
              }
            ]
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "geography": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "salesMotion": {
            "type": "string",
            "enum": [
              "service",
              "saas",
              "license",
              "hybrid"
            ]
          },
          "knownCompetitors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "internalDocumentIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ]
          }
        }
      },
      "ResearchMoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromStage",
          "reason"
        ],
        "properties": {
          "fromStage": {
            "$ref": "#/components/schemas/ResearchStage"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      },
      "ResearchActionResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "completedStages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResearchStage"
            }
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ProductResearchRun": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResearchActionResponse"
          },
          {
            "type": "object",
            "required": [
              "activeStage",
              "brief",
              "createdAt",
              "updatedAt",
              "stages"
            ],
            "properties": {
              "activeStage": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ResearchStage"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "brief": {
                "$ref": "#/components/schemas/ProductResearchBrief"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stage",
                    "status",
                    "attempts",
                    "lastErrorCode",
                    "startedAt",
                    "completedAt"
                  ],
                  "properties": {
                    "stage": {
                      "$ref": "#/components/schemas/ResearchStage"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queued",
                        "running",
                        "paused",
                        "completed"
                      ]
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lastErrorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "startedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "completedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "sourceType",
          "url",
          "title",
          "excerpt",
          "contentHash",
