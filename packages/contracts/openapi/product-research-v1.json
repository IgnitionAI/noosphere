{
  "openapi": "3.1.0",
  "info": {
    "title": "Ignition Outbound Product Research API",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/product-research-runs": {
      "post": {
        "operationId": "createProductResearchRun",
        "summary": "Create a product research draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductResearchBrief"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "getProductResearchRun",
        "summary": "Read run state and progress",
        "responses": {
          "200": {
            "description": "Current run state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResearchRun"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/evidence": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "listProductResearchEvidence",
        "summary": "List sourced evidence",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor page of evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/start": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "startProductResearchRun",
        "summary": "Queue the first research stage",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/pause": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "pauseProductResearchRun",
        "summary": "Pause future stage execution",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/resume": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "resumeProductResearchRun",
        "summary": "Resume the next incomplete stage",
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    },
    "/api/v1/product-research-runs/{runId}/actions/research-more": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "requestMoreProductResearch",
        "summary": "Invalidate machine checkpoints and restart from a stage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchMoreRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/ActionAccepted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/WorkspaceForbidden"
          },
          "404": {
            "$ref": "#/components/responses/RunNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidState"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ignition_session"
      }
    },
    "parameters": {
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "ActionAccepted": {
        "description": "Action accepted",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResearchActionResponse"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "Invalid request",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "WorkspaceForbidden": {
        "description": "Workspace role is insufficient",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "RunNotFound": {
        "description": "Run absent from the current workspace",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidState": {
        "description": "The requested transition is invalid",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "ResearchStage": {
        "type": "string",
        "enum": [
          "product_analysis",
          "competitor_discovery",
          "competitor_analysis",
          "segment_synthesis",
          "icp_synthesis",
          "evidence_review"
        ]
      },
      "ProductResearchBrief": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productUrl",
          "productName",
          "description",
          "geography",
          "languages",
          "salesMotion",
          "knownCompetitors",
          "internalDocumentIds",
          "depth"
        ],
        "properties": {
          "productUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "const": ""
              }
            ]
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "geography": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "salesMotion": {
            "type": "string",
            "enum": [
              "service",
              "saas",
              "license",
              "hybrid"
            ]
          },
          "knownCompetitors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "internalDocumentIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ]
          }
        }
      },
      "ResearchMoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromStage",
          "reason"
        ],
        "properties": {
          "fromStage": {
            "$ref": "#/components/schemas/ResearchStage"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      },
      "ResearchActionResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "completedStages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResearchStage"
            }
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ProductResearchRun": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResearchActionResponse"
          },
          {
            "type": "object",
            "required": [
              "activeStage",
              "brief",
              "createdAt",
              "updatedAt",
              "stages"
            ],
            "properties": {
              "activeStage": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ResearchStage"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "brief": {
                "$ref": "#/components/schemas/ProductResearchBrief"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stage",
                    "status",
                    "attempts",
                    "lastErrorCode",
                    "startedAt",
                    "completedAt"
                  ],
                  "properties": {
                    "stage": {
                      "$ref": "#/components/schemas/ResearchStage"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "queued",
                        "running",
                        "paused",
                        "completed"
                      ]
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lastErrorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "startedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "completedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "sourceType",
          "url",
          "title",
          "excerpt",
          "contentHash",
          "observedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "public_web",
              "internal_document"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "contentHash": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EvidencePage": {
        "type": "object",
        "required": [
          "data",
          "nextCursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
