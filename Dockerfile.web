FROM node:22-bookworm-slim AS node-runtime

FROM oven/bun:1.3.4-debian AS build

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

RUN bun install --frozen-lockfile
RUN node node_modules/next/dist/bin/next build apps/web \
  && bun scripts/prepare-web-standalone.ts

FROM node-runtime AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/* \
    /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg

COPY --chown=node:node --from=build /app/apps/web/.next/standalone ./

USER node

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
